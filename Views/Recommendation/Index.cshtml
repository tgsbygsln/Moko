@model List<AirFastNew.Models.Post>

<h2>Танд санал болгож буй зарууд</h2>
<div class="row">
    @if (!Model.Any())
{
    <p class="text-muted">Одоогоор санал болгох зар алга байна.</p>
}
@foreach (var post in Model)
{
    <div class="col-md-4">
        <div class="card mb-3">
            @if (post.PhotoPaths.Any())
            {
                var carouselId = $"carousel-{post.Id}";
                <div id="@carouselId" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < post.PhotoPaths.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@post.PhotoPaths[i]" class="d-block w-100 rounded" 
                                     style="height: 150px; object-fit: cover;" alt="Post Image">
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>
            }
            else
            {
                <span class="text-muted">No Image</span>
            }

            <div class="card-body">
                <h5 class="card-title">@post.Location</h5>
                <p class="card-text">@post.GetConditionDisplay()</p>
                <p class="fw-bold">Үнэ: ₮@post.Price.ToString("N0")</p> 
                <p class="fw-bold text-muted">
                    <span class="badge @(post.PostType == "rent" ? "bg-warning text-dark" : "bg-success")">
                        @(post.PostType == "rent" ? "🏠Түрээслүүлнэ" : "🏡Худалдана")
                    </span>
                </p>
                <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="btn btn-primary">Дэлгэрэнгүй</a>
            </div>
        </div>
    </div>
}
</div>